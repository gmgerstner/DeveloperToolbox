{
  "name": "developer-toolbox-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "open": "ng build && ng serve --open",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production --base-href /DeveloperToolbox/ && npm run copy:404",
    "copy:404": "node -e \"require('fs').copyFileSync('dist/developer-toolbox-ui/index.html', 'dist/developer-toolbox-ui/404.html')\"",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "bootstrap": "^5.3.8",
    "html-encoder-decoder": "^1.3.11",
    "js-base64": "^3.9.2",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "url-encode-decode": "^1.0.0",
    "uuid": "^14.0.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "~6.0.3"
  }
}
