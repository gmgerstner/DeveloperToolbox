{
  "name": "developer-toolbox-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "open": "vite --open",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && vite build --base=/DeveloperToolbox/ && npm run copy:404",
    "copy:404": "node -e \"require('fs').copyFileSync('dist/developer-toolbox-ui/index.html', 'dist/developer-toolbox-ui/404.html')\"",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "html-encoder-decoder": "^1.3.11",
    "js-base64": "^3.9.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "url-encode-decode": "^1.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
